{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "720px", "wideSize": "1240px" },

    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "customDuotone": false,
      "link": true,
      "palette": [
        { "slug": "crema",     "color": "#FFF6EA", "name": "Crema" },
        { "slug": "hueso",     "color": "#F6E9D6", "name": "Hueso" },
        { "slug": "blanco",    "color": "#FFFFFF", "name": "Blanco" },
        { "slug": "tinta",     "color": "#17110D", "name": "Tinta" },
        { "slug": "grafito",   "color": "#6B5B4D", "name": "Grafito" },
        { "slug": "bosque",    "color": "#103A2C", "name": "Bosque" },
        { "slug": "cordyceps", "color": "#FF6A13", "name": "Cordyceps naranja" },
        { "slug": "hericium",  "color": "#F4557E", "name": "Hericium rosa" },
        { "slug": "trametes",  "color": "#16A3A3", "name": "Trametes turquesa" },
        { "slug": "ganoderma", "color": "#A87BD4", "name": "Ganoderma violeta" },
        { "slug": "lima",      "color": "#CBE84E", "name": "Lima" }
      ]
    },

    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": true,
      "lineHeight": true,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Fraunces (titulares)",
          "fontFamily": "Fraunces, Georgia, 'Times New Roman', serif"
        },
        {
          "slug": "texto",
          "name": "Figtree (texto)",
          "fontFamily": "Figtree, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "xs",   "name": "XS",   "size": "0.8125rem", "fluid": false },
        { "slug": "sm",   "name": "SM",   "size": "0.9375rem", "fluid": { "min": "0.875rem",  "max": "0.9375rem" } },
        { "slug": "base", "name": "Base", "size": "1.0625rem", "fluid": { "min": "1rem",      "max": "1.0625rem" } },
        { "slug": "md",   "name": "MD",   "size": "1.25rem",   "fluid": { "min": "1.125rem",  "max": "1.25rem" } },
        { "slug": "lg",   "name": "LG",   "size": "1.625rem",  "fluid": { "min": "1.375rem",  "max": "1.625rem" } },
        { "slug": "xl",   "name": "XL",   "size": "2.25rem",   "fluid": { "min": "1.75rem",   "max": "2.25rem" } },
        { "slug": "xxl",     "name": "XXL",  "size": "3.25rem",   "fluid": { "min": "2.25rem",   "max": "3.25rem" } },
        { "slug": "xxxl",    "name": "XXXL",  "size": "4.75rem",   "fluid": { "min": "3rem",      "max": "4.75rem" } },
        { "slug": "display", "name": "Display",  "size": "6.5rem",    "fluid": { "min": "3.75rem",   "max": "6.5rem" } }
      ]
    },

    "spacing": {
      "defaultSpacingSizes": false,
      "customSpacingSize": true,
      "units": [ "px", "em", "rem", "vh", "vw", "%" ],
      "spacingSizes": [
        { "slug": "30", "name": "3XS", "size": "0.25rem" },
        { "slug": "35", "name": "2XS", "size": "0.5rem" },
        { "slug": "40", "name": "XS",  "size": "0.75rem" },
        { "slug": "45", "name": "SM",  "size": "1rem" },
        { "slug": "50", "name": "MD",  "size": "1.5rem" },
        { "slug": "55", "name": "LG",  "size": "clamp(1.75rem, 3vw, 2.25rem)" },
        { "slug": "60", "name": "XL",  "size": "clamp(2.5rem, 5vw, 3.5rem)" },
        { "slug": "65", "name": "2XL", "size": "clamp(3.5rem, 7vw, 5rem)" },
        { "slug": "70", "name": "3XL", "size": "clamp(5rem, 10vw, 7.5rem)" }
      ]
    },

    "border": { "color": true, "radius": true, "style": true, "width": true },
    "shadow": { "defaultPresets": false },

    "custom": {
      "radio": {
        "sm":     "6px",
        "md":     "12px",
        "lg":     "20px",
        "xl":     "32px",
        "pildora": "999px"
      },
      "borde": {
        "fino":   "1px solid var(--wp--preset--color--tinta)",
        "grueso": "2px solid var(--wp--preset--color--tinta)"
      },
      "sombra": {
        "carta":       "0 3px 0 0 var(--wp--preset--color--tinta)",
        "cartaHover":  "0 2px 0 0 var(--wp--preset--color--tinta)",
        "cartaActiva": "0 0 0 0 var(--wp--preset--color--tinta)",
        "cartaAlta":   "0 6px 0 0 var(--wp--preset--color--tinta)"
      },
      "boton": {
        "paddingY":  "0.9rem",
        "paddingX":  "1.75rem",
        "padding":   "0.9rem 1.75rem",
        "paddingSm": "0.6rem 1.15rem",
        "paddingLg": "1.15rem 2.4rem",
        "tracking":  "0.02em"
      },
      "badge": {
        "padding": "0.34rem 0.72rem"
      },
      "transicion": {
        "rapida": "140ms cubic-bezier(0.4, 0, 0.2, 1)",
        "media":  "260ms cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "tipografia": {
        "pesoTitular": "600",
        "pesoTexto":   "400",
        "pesoFuerte":  "700",
        "trackingTitular": "-0.02em",
        "trackingEtiqueta": "0.08em",
        "alturaTitular": "1.05",
        "alturaTexto":   "1.6",
        "alturaCompacta": "1.15"
      },
      "contenido": {
        "estrecho": "560px",
        "ancho":    "1240px",
        "completo": "1440px"
      }
    }
  },

  "styles": {
    "color": { "background": "var(--wp--preset--color--crema)", "text": "var(--wp--preset--color--tinta)" },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--texto)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "fontWeight": "var(--wp--custom--tipografia--peso-texto)",
      "lineHeight": "var(--wp--custom--tipografia--altura-texto)"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--50)",
      "padding": {
        "left":  "var(--wp--preset--spacing--50)",
        "right": "var(--wp--preset--spacing--50)"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "var(--wp--custom--tipografia--peso-titular)",
          "lineHeight": "var(--wp--custom--tipografia--altura-titular)",
          "letterSpacing": "var(--wp--custom--tipografia--tracking-titular)"
        }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xxxl)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xxl)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)" } },
      "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--lg)" } },
      "h5": { "typography": { "fontSize": "var(--wp--preset--font-size--md)" } },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--texto)",
          "fontSize": "var(--wp--preset--font-size--xs)",
          "fontWeight": "var(--wp--custom--tipografia--peso-fuerte)",
          "letterSpacing": "var(--wp--custom--tipografia--tracking-etiqueta)",
          "textTransform": "uppercase"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--bosque)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--cordyceps)" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--bosque)",
          "text": "var(--wp--preset--color--crema)"
        },
        "border": { "radius": "var(--wp--custom--radio--pildora)" },
        "spacing": {
          "padding": {
            "top": "var(--wp--custom--boton--padding-y)", "bottom": "var(--wp--custom--boton--padding-y)",
            "left": "var(--wp--custom--boton--padding-x)", "right": "var(--wp--custom--boton--padding-x)"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--texto)",
          "fontSize": "var(--wp--preset--font-size--sm)",
          "fontWeight": "var(--wp--custom--tipografia--peso-fuerte)",
          "letterSpacing": "var(--wp--custom--boton--tracking)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--cordyceps)",
            "text": "var(--wp--preset--color--tinta)"
          }
        }
      }
    }
  }
}
